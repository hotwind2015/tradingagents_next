{# Professional Report Template with Jinja2 Macros #}
{% macro render_table(headers, rows, alignments=None) -%}
{%- if rows -%}
{%- if alignments is none -%}{% set alignments = [''] * headers|length %}{%- endif -%}
| {{ headers | join(' | ') }} |
| {%- for a in alignments -%}{{ '---' ~ a }}{% if not loop.last %} | {% endif %}{%- endfor -%} |
{%- for row in rows -%}
| {{ row | join(' | ') }} |
{%- endfor -%}
{%- endif -%}
{% endmacro %}

{% macro render_kv_table(data, key_header='Field', value_header='Value') -%}
{%- if data -%}
| **{{ key_header }}** | **{{ value_header }}** |
| :--- | :--- |
{%- for k, v in data.items() -%}
| **{{ k }}** | {{ v }} |
{%- endfor -%}
{%- endif -%}
{% endmacro %}

{% macro section_header(title, level=2) -%}
{{ '#' * level }} {{ title }}

{% endmacro %}

{% macro evidence_row(ev) -%}
| `{{ ev.evidence_id }}` | {{ ev.evidence_type }} | {{ ev.provider }} | {{ ev.summary }} | {{ ev.metadata.processing_level if ev.metadata else 'N/A' }} | {{ ev.metadata.quality_scores | tojson if ev.metadata and ev.metadata.quality_scores else '-' }} |
{% endmacro %}

{% macro lineage_chain(ev) -%}
{%- if ev.lineage -%}
**{{ i18n.t('report.lineage') }}**: {% for anc in ev.lineage %}`{{ anc }}`{% if not loop.last %} → {% endif %}{% endfor %}
{%- endif -%}
{% endmacro %}

{% macro processing_chain(ev) -%}
{%- if ev.metadata and ev.metadata.processing_chain -%}
**{{ i18n.t('report.processing_chain') }}**: {{ ev.metadata.processing_chain | join(' → ') }}
{%- endif -%}
{% endmacro %}

{% macro quality_scores(ev) -%}
{%- if ev.metadata and ev.metadata.quality_scores -%}
**{{ i18n.t('report.quality') }}**: {{ ev.metadata.quality_scores | tojson }}
{%- endif -%}
{% endmacro %}

